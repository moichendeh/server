# Copy this file to ".env" (same folder) and fill in your own values.
# .env is never committed to git and never sent to the browser.

# Any long random string - used to sign login sessions. Changing it logs everyone out.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Which port the backend listens on. On a real host this is usually set for you
# automatically and you can leave this line out entirely.
PORT=3000

# Your PostgreSQL connection string. For a free hosted database (e.g. Neon), this is
# the "Connection string" shown on their dashboard, looks like:
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=REPLACE_WITH_YOUR_POSTGRES_CONNECTION_STRING

# Optional. Your api.bible (scripture.api.bible) API key - enables the NIV, AMP and
# CSB translations. Leave blank/unset and those translations just show as unavailable.
API_BIBLE_KEY=

# Optional. Your Anthropic API key (console.anthropic.com) - enables AI spelling/
# grammar correction and translation. Leave blank/unset and those features just
# report as turned off.
ANTHROPIC_API_KEY=

# Which Claude model the AI features call. claude-haiku-4-5 is Anthropic's current
# small/fast/low-cost model as of when this was written.
ANTHROPIC_MODEL=claude-haiku-4-5

# Site-wide kill switch for the AI features - set to "false" to force them off
# regardless of the admin-panel toggle.
AI_ENABLED=true

# Daily per-user caps (characters and requests) that protect against a runaway bill.
AI_DAILY_CHAR_LIMIT=150000
AI_DAILY_REQUEST_LIMIT=1000
